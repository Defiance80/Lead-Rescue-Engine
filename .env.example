# ── Database (Postgres) ─────────────────────────────────────────────
# On Vercel: Storage → Create Database → Neon (Postgres). It fills these in for you.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Optional: direct (non-pooled) connection used when creating tables. Neon adds it
# automatically; if your database only gives you DATABASE_URL, leave this out.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# ── Auth.js ─────────────────────────────────────────────────────────
# Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google sign-in — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: "email me a sign-in link" (doubles as forgot-password) — https://resend.com/api-keys
AUTH_RESEND_KEY=""
# Must be an address on a domain you verified in Resend
EMAIL_FROM="Lead Rescue <login@yourdomain.com>"

# Recommended: only these emails may create accounts / sign in (comma separated). Leave blank to allow anyone.
ALLOWED_EMAILS=""

# ── Inbox Assistant ─────────────────────────────────────────────────
# AI sorting, detail extraction and reply drafting (https://console.anthropic.com).
# Without it the assistant still works in a basic keyword mode.
ANTHROPIC_API_KEY=""

# Encrypts stored mailbox passwords and Mailchimp/HubSpot keys. Generate once
# (python -c "import secrets; print(secrets.token_urlsafe(32))") and never change it,
# or saved connections will need to be re-entered. Falls back to AUTH_SECRET.
ENCRYPTION_KEY=""

# Protects the scheduled-check URLs (/api/cron and /api/cron/inbox).
CRON_SECRET=""
