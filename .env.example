# ── Database (Postgres) ─────────────────────────────────────────────
# On Vercel: Storage → Create Database → Neon (Postgres). It fills these in for you.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Optional: direct (non-pooled) connection used when creating tables. Neon adds it
# automatically; if your database only gives you DATABASE_URL, leave this out.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# ── Auth.js ─────────────────────────────────────────────────────────
# Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Password sign-in: email + this shared password (12+ characters, or it's ignored).
# Pair it with ALLOWED_EMAILS below.
APP_PASSWORD=""

# Google sign-in — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (magic link) sign-in — https://resend.com/api-keys
AUTH_RESEND_KEY=""
# Must be an address on a domain you verified in Resend
EMAIL_FROM="Lead Rescue <login@yourdomain.com>"

# Optional: only these emails may sign in (comma separated). Leave blank to allow anyone.
ALLOWED_EMAILS=""
