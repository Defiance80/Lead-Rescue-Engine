// Lead Rescue Engine — database schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Auth.js tables (do not rename) ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Agent settings
  displayName   String? // how the agent signs messages ("Ian")
  businessName  String? // optional brokerage/team name for email signatures
  phone         String?
  timezone      String  @default("America/Los_Angeles")
  quietStart    Int     @default(21) // no automated messages from 9pm…
  quietEnd      Int     @default(8) //  …until 8am (agent's local time)
  intakeToken   String  @unique @default(uuid()) // secret used in webhook URLs
  onboarded     Boolean @default(false)

  accounts Account[]
  sessions Session[]
  leads    Lead[]
  issues   IntakeIssue[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Lead Rescue Engine ──────────────────────────────────────────────────────

enum LeadType {
  BUYER
  SELLER
  BOTH
  UNKNOWN
}

enum LeadStatus {
  NEW // just arrived, no human/auto contact yet
  CONTACTED // we reached out, no reply yet
  ENGAGED // they replied / interacted
  APPOINTMENT // showing / consult booked
  CLIENT // signed / under contract
  LONG_GAME // long-term nurture
  CLOSED // not moving forward
}

model Lead {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String?
  email       String?
  phone       String? // stored as E.164 (+13105551234) when valid
  source      String   @default("Website")
  campaign    String?
  property    String? // original property / address
  mlsNumber   String?
  city        String? // primary market
  priceMin    Int?
  priceMax    Int?
  inquiry     String? // original inquiry text, never overwritten
  landingPage String?
  referral    String?
  timeline    String?
  financing   String?
  leadType    LeadType @default(UNKNOWN)

  score   Int        @default(0)
  signals String[] // scoring signal keys, see src/lib/scoring.ts
  status  LeadStatus @default(NEW)

  autopilot        Boolean @default(true) // follow-up sequence running?
  autopilotNote    String? // why it was paused
  needsAgent       Boolean @default(false) // escalated — wants a human
  needsAgentReason String?
  reviewFlag       String? // sensitive conversation → human review

  smsConsent    Boolean @default(true)
  emailOptOut   Boolean @default(false)
  doNotContact  Boolean @default(false)
  isSample      Boolean @default(false)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  firstResponseAt  DateTime?
  lastContactAt    DateTime?
  lastEngagementAt DateTime?
  snoozedUntil     DateTime?

  touches    Touch[]
  activities Activity[]

  @@index([userId, score])
  @@index([userId, createdAt])
  @@index([userId, email])
  @@index([userId, phone])
}

enum Channel {
  SMS
  EMAIL
  TASK
}

enum TouchStatus {
  PENDING
  DONE
  SKIPPED
}

// One step in the follow-up plan (Day 0, 1, 3, 7, 14, 30)
model Touch {
  id          String      @id @default(cuid())
  leadId      String
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  day         Int
  channel     Channel
  label       String
  subject     String?
  message     String
  dueAt       DateTime
  status      TouchStatus @default(PENDING)
  completedAt DateTime?
  completedBy String? // "agent" | "autopilot"

  @@index([leadId, status, dueAt])
}

// Timeline + audit log. Every meaningful change lands here.
model Activity {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind       String // created | merged | sms | email | call | note | reply | event | status | autopilot | score | alert
  title      String
  body       String?
  scoreDelta Int?
  actor      String   @default("system") // system | agent | autopilot | n8n
  createdAt  DateTime @default(now())

  @@index([leadId, createdAt])
}

enum IssueStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// The Rescue Queue: anything that could not be cleanly processed.
// Nothing silently disappears.
model IntakeIssue {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // unreachable | possible_spam | invalid_email | invalid_phone | missing_name | bad_payload | duplicate_merged
  problem   String
  payload   Json
  leadId    String?
  status    IssueStatus @default(OPEN)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId, status])
}
